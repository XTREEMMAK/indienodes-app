# Serves the prerendered output of `npm run build` (adapter-static, plain
# HTML/CSS/JS, no server process behind it). There is nothing for Caddy to
# reverse-proxy or execute — this is a static file server, full stop, which
# is the whole point of the project's "no required backend for the reader or
# widget" promise: the submission form's webhook is a separate service this
# container never talks to.
#
# Port 8080, not 80: binding a port below 1024 needs root or a Linux
# capability, and this runs as a non-root user (see Dockerfile). No TLS is
# terminated here either; that is expected to sit in front of this
# container, not inside it.
:8080 {
	root * /srv
	encode zstd gzip

	# Baseline browser hardening for every static response.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"

		# script-src and style-src both carry 'unsafe-inline' -- not the
		# original intent here. A single exact hash for app.html's own inline
		# theme/skin bootstrap was going to be script-src's only exception,
		# since app.html is copied through verbatim and that script's bytes
		# never change on their own. That covers app.html's script, but not
		# what SvelteKit itself inlines into every prerendered page on top of
		# it: a `kit.start(...)` hydration bootstrap carrying that page's own
		# serialized load data (comic/text: page and excerpt content; every
		# page: the layout's own changelog-derived `releases` list), and on
		# some routes a `data-sveltekit-fetched` script caching a fetched
		# response (`ring.json`, on any page whose load fetches it during
		# prerendering). Both are generated per page and per build, so neither
		# has one stable hash the way app.html's own script does -- verified
		# 2026-08-31 the hard way, by actually applying a hash-only version of
		# this policy in a browser (testing/csp.e2e.js) rather than trusting it
		# unread: it blocked its own hydration outright on every route, which
		# is a much worse outcome than the inline-script risk CSP exists to
		# reduce. A real fix needs a build step that hashes each built page's
		# own scripts and injects a matching per-page `<meta>` policy -- real,
		# separate work, tracked in roadmap.md, not done here. style-src has
		# the same shape of problem one level down: dozens of components
		# compute `style:` bindings and `style="..."` attributes from live
		# state (positions, timings, aspect ratios), and CSP governs a shadow
		# root's own <style> element the same as any other, so
		# `<indienode-widget>`'s shadow DOM needs this exception too. Neither
		# is nonce/hash-coverable short of that same per-page build step.
		#
		# challenges.cloudflare.com covers Turnstile's own script and the
		# challenge iframe it renders, present in the CSP unconditionally
		# because TURNSTILE_ENABLED is a build-time choice this static Caddy
		# config has no visibility into -- harmless to allow when unused, since
		# CSP only permits, it does not load anything on its own.
		#
		# img-src/media-src allow any `https:` host, not an allowlist: creator
		# media is genuinely arbitrary-host by design (this ring has no CDN of
		# its own), so the alternative is breaking legitimate member content.
		# img-src also carries `blob:` for the same reason `data:` is there:
		# /join's cover-art picker (JoinEntryStep.svelte) previews the chosen
		# file via `URL.createObjectURL` before anything is uploaded, so the
		# preview `<img>` src is a `blob:` URL, not yet an `https:`/`data:` one.
		# connect-src names `ring.indienodes.us` explicitly for the same reason
		# the widget's own CORS carve-out above does -- `RING_ENDPOINT_URL`
		# crosses there in production. A fork pointing `VITE_RING_URL`
		# elsewhere needs to update this too; `loadRing`'s own fallback to the
		# same-origin mirror degrades gracefully in the meantime rather than
		# breaking outright, since a CSP-blocked fetch rejects like any other
		# failed one.
		#
		# `n8n.kjnet.us` is `VITE_SUBMISSION_WEBHOOK_URL`/`VITE_CONTACT_WEBHOOK_URL`'s
		# real host in this deployment -- every call `webhookClient.js` makes
		# (issue_token, verify, submit, submit_update, request_removal,
		# contact) goes through it, from `/join`, `/update`, and `/contact`
		# alike. Missed in the pass that first wrote this policy, which
		# checked the widget's and the ring's own connect-src needs but never
		# audited the submission/contact webhook path -- caught live on
		# `/update`'s Verify step, not by `testing/csp.e2e.js`, because
		# neither e2e project that suite runs against actually attempts this
		# fetch: the "production" project builds with no webhook URL
		# configured at all (submissions render as closed), and
		# "join-mock-dev" deliberately mocks around the real call. Fixed by
		# giving "production" real webhook URLs too, so the join/update flow
		# now exercises this exact path. A fork pointing either webhook
		# variable elsewhere needs to update this origin too.
		#
		# frame-src is the iframes this app's own pages ever render: 'self'
		# for /widget's own live preview of the sandboxed embed (a real
		# same-origin <iframe src="/embed-frame">, not a mockup), YouTube's
		# no-cookie player for game trailers, and Turnstile's challenge
		# widget. frame-ancestors 'none' restates X-Frame-Options DENY as
		# CSP, which takes precedence in every current browser -- scoped out
		# entirely for /embed-frame below, whose one purpose is being framed
		# by any member site.
		#
		# Still real, even with both exceptions: object-src/base-uri/
		# form-action lock down three whole attack classes outright, frame-src
		# and connect-src are real allowlists (not wildcards), and img-src/
		# media-src/font-src stay scoped to what this app actually needs
		# rather than defaulting open.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https:; connect-src 'self' https://ring.indienodes.us https://n8n.kjnet.us https://challenges.cloudflare.com; frame-src 'self' https://www.youtube-nocookie.com https://challenges.cloudflare.com; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	}

	# The three things a member's own site fetches from this one. Without these
	# the widget cannot work anywhere except this domain, which is the opposite
	# of what it is for.
	#
	# `embed.v1.js` is a `type="module"` script, and module scripts are always
	# fetched in CORS mode — unlike a classic script, which is `no-cors` and
	# would have loaded cross-origin without any of this. So a member pasting
	# the documented snippet got a script that silently never executed and a
	# `<indienode-widget>` that stayed an unknown element: no error on their
	# page, nothing in this server's log, just a blank space.
	#
	# `ring.json` is the fetch the widget makes once it does run, and it is
	# cross-origin for exactly the same reason. Either one missing is enough to
	# leave the widget dead on every site but this one.
	#
	# `*` rather than an allowlist: the ring is public data served to anybody,
	# the whole design is that a member's site is not registered with this one,
	# and no request here carries a credential for `*` to be unsafe with. The
	# badge and text tiers are an `<img>` and an `<a>`, which need no CORS at
	# all — which is why those two kept working while the full widget did not,
	# and why that difference is the symptom to recognize this by.
	@embeddable path /embed.js /embed.v1.js /ring.json
	header @embeddable Access-Control-Allow-Origin "*"

	# Every SvelteKit build asset under here is content-hashed into its own
	# filename (adapter-static's normal output shape) -- a new build never
	# reuses one of these paths for different bytes, so caching them for a
	# year is safe: a deploy that changes anything ships under new filenames,
	# which the newly-built HTML references, not these.
	#
	# Access-Control-Allow-Origin is needed here for the same reason it's
	# needed on @embeddable above, one layer further down: /embed-frame is
	# loaded by a member's page in a `sandbox="allow-scripts ..."` iframe with
	# no `allow-same-origin` (deliberate -- see docs/decisions.md), which
	# gives that document a permanently opaque (`null`) origin. Module scripts
	# and dynamic `import()` are always fetched in CORS mode regardless of
	# physical same-hostness, so the browser loading /embed-frame's own
	# SvelteKit hydration chunks from under here needs this header exactly
	# like embed.v1.js does -- missing it left every iframe-tier embed dead on
	# any page but this one (and even this app's own /widget preview, whose
	# same-origin iframe hits the identical opaque-origin fetch). `*` is safe
	# for the same reason it's safe on @embeddable: these are public,
	# content-hashed build assets with no user data and no credentialed
	# request anywhere in this app ever reaches them.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @immutable Access-Control-Allow-Origin "*"

	# ring.json updates near-real-time (repository_dispatch from the ring repo
	# publishing, see .github/workflows/sync-ring.yml, with a twice-daily cron
	# only as a fallback for a missed dispatch), so staleness here should stay
	# bounded to minutes, not the year-long caching above -- deliberately its
	# own matcher rather than folded into @embeddable, which also covers
	# embed.js/embed.v1.js. Those two are NOT given any Cache-Control: they are
	# deliberately mutable at a fixed URL (a new build overwrites the same
	# path; "v1" pins a behavioral contract, not content -- see decisions.md
	# and security-audit-2026-08-27.md, the same reasoning that ruled out SRI
	# for them), so letting a browser cache them past a redeploy would be a
	# real regression, not a harmless optimization.
	@ring-json path /ring.json
	header @ring-json Cache-Control "public, max-age=300"

	# The sandboxed-iframe widget target (src/routes/embed-frame). A member's
	# page loads this cross-origin in an <iframe sandbox="allow-scripts
	# allow-popups allow-popups-to-escape-sandbox">, so it needs the opposite
	# of the site-wide X-Frame-Options above -- that DENY exists to stop
	# *this app's own pages* from being framed, but this one page's entire
	# purpose is to be framed by any member site, and there is no allowlist
	# to write since membership is open. `frame-ancestors *` is CSP's
	# replacement for X-Frame-Options and is what actually governs framing in
	# every current browser; the bare `-X-Frame-Options` below removes the
	# global DENY for just this path so the two headers don't disagree.
	#
	# The rest of this policy is deliberately tight, since this document has
	# no reason to do anything but mount the widget: `img-src 'self' data:`
	# covers the inlined logo data URI, and `font-src 'self'` covers this
	# deployment's own bundled fonts, still same-origin only.
	#
	# `connect-src` names `ring.indienodes.us` alongside 'self' for the same
	# reason the site-wide policy above does, and it has to: this deployment
	# builds with VITE_RING_URL set to that host, so the widget's own
	# ring.json fetch leaves this origin. 'self' alone did not fail loudly --
	# `loadRing` catches the blocked fetch and falls back to this origin's
	# committed mirror (src/lib/ring.js) -- so the symptom was the default
	# widget tier quietly serving the five-minute-cached mirror instead of the
	# canonical endpoint, plus one console violation per load. Left as a
	# hypothetical here ("add that origin if one is ever configured") from the
	# policy's first version until docs/ring-audit-2026-09-04.md found the
	# variable had in fact been set since 2026-08-31.
	#
	# testing/csp.e2e.js cannot catch a regression here: the e2e build sets no
	# VITE_RING_URL, so its ring fetch is same-origin and this entry is inert
	# under test. src/lib/widgetCors.test.js asserts it against the Caddyfile
	# instead, which is where the rest of this file's cross-origin contract is
	# already guarded.
	#
	# script-src and style-src both carry 'unsafe-inline' -- verified
	# 2026-08-31, the hard way, by actually applying this policy in a browser
	# rather than trusting it unread: this page is an ordinary SvelteKit
	# route, and every prerendered SvelteKit page ships its OWN inline
	# hydration bootstrap (the `kit.start(...)` call and any
	# `data-sveltekit-fetched` payload), whose content is generated per page
	# and per build and therefore has no single stable hash the way
	# app.html's own bootstrap script does. A stricter script-src here blocks
	# that hydration script outright, silently killing the `onMount` that
	# loads /embed.v1.js -- exactly the failure this policy had at first,
	# caught only because testing/csp.e2e.js applies the real header in a
	# real browser instead of trusting the Caddyfile on inspection alone.
	# style-src has the same problem one level down: CSP governs a
	# shadow root's own <style> element same as any other, and
	# `<indienode-widget>`'s shadow DOM ships one inline, with no nonce/hash
	# mechanism reaching into a custom element's own template. `default-src
	# 'none'` plus the narrow allowlists above still do real work; only
	# script/style execution is unrestricted, and this page has no
	# user-controlled data reaching any HTML sink to exploit that with.
	@embed-frame path /embed-frame
	header @embed-frame {
		-X-Frame-Options
		Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://ring.indienodes.us; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors *"
	}

	# Temporary pre-launch access gate, present ONLY in images built with
	# GATE_USER/GATE_PASSWORD_HASH set (see the Dockerfile and gate/gate.caddy).
	# A glob rather than a named import, because `import` of a named file that
	# does not exist is a hard config ERROR -- an ungated image would refuse to
	# start. Verified against caddy:2-alpine directly, along with the two
	# alternatives: a glob matching nothing logs `No files matching import glob
	# pattern` and carries on, and an existing-but-empty named file logs
	# `Import file is empty` and carries on. So the glob is not silent, but it
	# is the only one of the three that needs no file on disk at all -- an
	# ungated image never creates the directory, leaving this line inert with
	# nothing beside it to find.
	#
	# Must stay above `handle_errors` below: the gate contributes its own
	# status-filtered `handle_errors 401`, and a filtered block only wins over
	# the unfiltered fallback if it has been parsed alongside it.
	import /etc/caddy/conf.d/*.caddy

	# Every real route is prerendered to its own flat file (join.html,
	# members.html, ...), NOT a directory with an index.html inside it, and
	# there is no trailingSlash config to change that (see vite.config.js).
	# Appending .html is therefore correct, and `{path}/` must NOT be in this
	# list: that would make a path like `/join/` resolve to a directory
	# listing attempt instead of falling through to the real file, in a way
	# that would only ever look right by accident on routes that happen to
	# have no trailing content of their own.
	try_files {path} {path}.html
	file_server

	# adapter-static's `fallback: '404.html'` (see vite.config.js, and
	# src/routes/+error.svelte for what it renders) is what an unmatched
	# path gets. Without naming it here, an unmatched request still 404s
	# correctly, just with Caddy's own bare "404 Not Found" instead of the
	# app's real error page.
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
