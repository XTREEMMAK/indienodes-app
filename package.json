{
	"name": "indienodes-v2",
	"description": "A decentralized indie-creator discovery webring built around a public ring.json data source.",
	"license": "GPL-3.0-or-later",
	"private": true,
	"version": "1.5.0-rc.2",
	"type": "module",
	"scripts": {
		"dev": "npm run build:widget && vite dev",
		"dev:fixture": "npm run build:widget && VITE_RING_URL=:4174/ring.test.json vite dev",
		"build": "npm run build:widget && vite build && node scripts/verify-production-build.js",
		"build:widget": "vite build --config vite.widget.config.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; node scripts/install-hooks.mjs || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --compiler-warnings \"options_missing_custom_element:ignore\"",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch --compiler-warnings \"options_missing_custom_element:ignore\"",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"android": "npm run build && node scripts/platforms/run-capacitor.mjs run android",
		"android:sync": "npm run build && node scripts/platforms/run-capacitor.mjs sync android",
		"android:open": "npm run android:sync && node scripts/platforms/run-capacitor.mjs open android",
		"android:build": "npm run android:sync && node scripts/platforms/run-capacitor.mjs build android",
		"desktop:assets": "npm run build && node scripts/platforms/sync-wails-assets.mjs",
		"desktop": "node scripts/platforms/run-wails.mjs dev",
		"desktop:build": "node scripts/platforms/run-wails.mjs build",
		"platforms:check": "node scripts/platforms/verify-versions.mjs",
		"ring:sync": "node scripts/sync-ring-mirror.mjs",
		"ring:validate": "node scripts/validate-ring-mirror.mjs",
		"generator:preview": "node scripts/preview-generator-template.js",
		"generator:preview:once": "node scripts/preview-generator-template.js --once",
		"generator:new": "node scripts/scaffold-generator-template.js",
		"fixture:serve": "node testing/scripts/serve.mjs",
		"fixture:generate": "node testing/scripts/generate-fixture.mjs",
		"fixture:audio": "node testing/scripts/fetch-xeno-audio.mjs",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/core": "^8.5.0",
		"@fontsource-variable/karla": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@friendofsvelte/tipex": "^0.2.0",
		"gridstack": "^13.0.2",
		"isomorphic-dompurify": "^3.19.0",
		"jszip": "^3.10.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-html": "^16.0.1"
	}
}
