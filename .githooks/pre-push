#!/bin/sh
# Refuses a push whose committed ring mirror is malformed.
#
# `ci.yml` already runs this same check, and `docker-publish.yml` gates on
# `ci.yml`, so a broken mirror cannot reach production either way. What CI
# cannot do is keep it out of the history: by the time CI speaks, the commit
# is on `main`. This is the same check one step earlier.
#
# This repo no longer authors ring.json -- it mirrors indienodes-ring,
# refreshed by `npm run ring:sync`. So unlike the check this replaced, there
# is nothing to rebuild here: a failure means either something hand-edited
# the mirror directly (don't -- it will be overwritten on the next sync) or
# the mirror was left mid-way through a sync that itself failed.
#
# Network-free on purpose, same reasoning as ci.yml's own step: this checks
# that what's already committed is well-formed, not whether it's fresh.
# Freshness is `ring:sync`'s job, not a push-time concern.
#
# Note it validates the working tree, not the commits being pushed.
# Uncommitted drift blocks the push too. That is the intended bias — the
# check is cheap and a broken mirror is worth knowing about — but it is why
# the escape hatch below is worth knowing.
#
# To bypass once: git push --no-verify
# To turn off entirely: git config --unset core.hooksPath

# Each check guards its own prerequisites rather than the whole hook exiting
# early on the first missing file, so that a partial checkout skips only the
# check it cannot run.

if [ -f scripts/validate-ring-mirror.mjs ] && ! node scripts/validate-ring-mirror.mjs; then
	echo ''
	echo 'pre-push: the ring mirror is malformed, so this push was stopped.'
	echo '          Run `npm run ring:sync` to refresh it from the canonical'
	echo '          source, commit the result, and try again.'
	echo '          To push anyway: git push --no-verify'
	exit 1
fi

# Refuses a push whose n8n generator has changed without the matching export.
#
# `scripts/n8n/test_code_nodes.mjs` runs the generated code nodes straight out
# of build_workflows.py, so it goes green on a rule that has never reached n8n.
# That is not hypothetical: the relaxed consent gate committed on 2026-09-09
# sat unpushed until 2026-09-12 with a full green suite, and every submission
# from a creator who is not a PRO member was rejected on live for those three
# days. Tests prove the generator is right; only the export proves it shipped.
#
# Network-free and key-free, exactly like the mirror check above: it compares
# the committed generator against the committed export, never the live
# instance. A red result means run --push then --export, not that n8n is down.
#
# python3 may legitimately be absent (a Node-only contributor, the Docker
# build), so its absence skips the check rather than blocking a push.
if [ -f scripts/n8n/build_workflows.py ] && command -v python3 >/dev/null 2>&1; then
	if ! python3 scripts/n8n/build_workflows.py --check-drift; then
		echo ''
		echo 'pre-push: the n8n generator has changed but backups/ has not, so'
		echo '          this push was stopped. The workflows above are live with'
		echo '          the previous version of that code. To resolve:'
		echo '            python3 scripts/n8n/build_workflows.py --push'
		echo '            python3 scripts/n8n/build_workflows.py --export'
		echo '          then commit the refreshed backups and try again.'
		echo '          To push anyway: git push --no-verify'
		exit 1
	fi
fi
